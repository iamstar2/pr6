# ================================
# rpi_backend 환경변수 예시 파일
# 실제 값은 .env 파일에 작성하고 절대 Git에 커밋하지 않는다.
# ================================

# --- inference 서비스: ONNX 모델 설정 ---
MODEL_PATH=/app/model/best.onnx
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45

# --- 미착용 판정 클래스 매핑 ---
# 실제 모델의 class 이름은 tools/inspect_model.py 로 먼저 확인할 것.
# 쉼표(,)로 여러 개의 후보 이름을 등록할 수 있다 (대소문자/공백 무시하고 비교함).
#
# 아래 기본값은 기본 탑재 모델인 Hansung-Cho/yolov8-ppe-detection (YOLOv8n) 기준이다.
# 이 모델의 전체 class(10종): Hardhat, Mask, NO-Hardhat, NO-Mask, NO-Safety Vest,
#                             Person, Safety Cone, Safety Vest, machinery, vehicle
# Mask/NO-Mask, Safety Cone, machinery, vehicle은 현재 시스템에서 미착용 판정에 사용하지 않는다
# (안전모/안전조끼만 판정). 다른 모델로 교체하면 반드시 inspect_model.py로 다시 확인할 것.
NO_HELMET_CLASSES=NO-Hardhat,no_helmet,without_helmet
NO_VEST_CLASSES=NO-Safety Vest,no_vest,without_vest

# --- 중복 이벤트 방지 (초 단위) ---
EVENT_COOLDOWN_SEC=5

# --- 서비스 간 내부 통신 주소 (docker-compose 서비스명 기준) ---
INFERENCE_URL=http://inference:8001
CLOUD_URL=http://cloud:8002

# --- Supabase 설정 ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=violations
SUPABASE_TABLE=violations

# --- 메타데이터 (DB 기록용) ---
MODEL_NAME=yolov8-ppe-detection
MODEL_VERSION=hansung-cho-v1
