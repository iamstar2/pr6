# Copy this to rpi5/.env and edit — it's the ONE file with every value that differs
# per person/deployment (Wi-Fi-equivalent stuff for this service): where the web
# dashboard lives, and which cloud storage backend + credentials to use.
# rpi5/.env is gitignored — safe to put real Supabase keys here. Loaded automatically
# (see cloud/factory.py's load_dotenv()) — no manual `export` needed for local dev,
# and Docker Compose reads it too via `env_file:` in docker-compose.yml.

HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
WEB_BACKEND_URL=http://localhost:4000
RPI5_CONFIG_PATH=./config.yaml

# ---------- Cloud storage (violations only) ----------
# "local_mock" (default, no account needed) or "supabase".
CLOUD_PROVIDER=local_mock

# local_mock settings (ignored unless CLOUD_PROVIDER=local_mock)
CLOUD_MOCK_STORAGE_DIR=../cloud/_mock_storage
CLOUD_MOCK_PUBLIC_BASE_URL=http://localhost:8000/mock-media

# supabase settings (ignored unless CLOUD_PROVIDER=supabase) — see cloud/README.md
# for the one-time Supabase project setup (Storage bucket + cloud/supabase_schema.sql).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=violations
SUPABASE_TABLE=violation_records

# ---------- Security ----------
# Shared secret ESP32 must send as the X-API-Key header on POST /api/v1/detect.
# Empty = auth disabled (fine for local dev only — never leave this empty once
# the server is reachable from anything other than your own machine).
DEVICE_API_KEY=

# Reject uploads bigger than this (bytes). 5MB is generous headroom over a VGA JPEG.
MAX_UPLOAD_BYTES=5242880

# Shared secret this server sends as X-Internal-Token when calling the web
# backend's /api/events/* — must match the web backend's own INGRESS_TOKEN
# (see web/.env.example). Empty = no header sent.
WEB_INGRESS_TOKEN=

# ---------- Reliability (graceful degradation) ----------
# Violations that fail to reach cloud storage are queued here and retried
# automatically instead of being lost. Contains real violation photos — gitignored.
RETRY_QUEUE_DIR=./data/retry_queue
RETRY_INTERVAL_SECONDS=30
WEB_EVENT_MAX_RETRIES=3
WEB_EVENT_BACKOFF_BASE_S=0.5

# ---------- Environment profile / logging ----------
# development | staging | production — selects the default LOG_LEVEL below when
# LOG_LEVEL itself is left blank (DEBUG in development, INFO otherwise).
ENV=development
LOG_LEVEL=
LOG_DIR=./logs
# Optional: also ship every log line to a central collector (Loki/ELK/CloudWatch
# ingest endpoint, ...). Leave blank to log to console + local rotating file only.
LOG_SHIP_URL=
