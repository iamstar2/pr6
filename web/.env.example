# Port the custom Node server (server.js) listens on. rpi5's web_backend_url
# should point here, e.g. http://localhost:4000
PORT=4000

# URL the browser's Socket.IO client connects to. Must be reachable from the
# browser (not just the server), so use a host/port the browser can resolve.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Shared secret RPi5 must send as X-Internal-Token on POST /api/events/* — must
# match rpi5's own WEB_INGRESS_TOKEN (see rpi5/.env.example). Empty = auth
# disabled (fine for local dev only).
INGRESS_TOKEN=

# Origin allowed to call the ingress endpoints / open the Socket.IO connection.
# '*' is fine for local dev; set this to the real dashboard origin (e.g.
# https://dashboard.example.com) once this is reachable from outside your LAN.
ALLOWED_ORIGIN=*

# debug | info | warn | error (default: info)
LOG_LEVEL=info
