# Port the custom Node server (server.js) listens on. rpi5's web_backend_url
# should point here, e.g. http://localhost:4000
PORT=4000

# URL the browser's Socket.IO client connects to. Must be reachable from the
# browser (not just the server), so use a host/port the browser can resolve.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
