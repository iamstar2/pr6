# Copy to .env (or set these in rpi5's environment — rpi5 is the only caller of this module).

CLOUD_PROVIDER=local_mock

# --- local_mock (implemented, default) ---
CLOUD_MOCK_STORAGE_DIR=./cloud/_mock_storage
CLOUD_MOCK_PUBLIC_BASE_URL=http://localhost:8000/mock-media

# --- supabase (implemented, see providers/supabase_provider.py) ---
# Set CLOUD_PROVIDER=supabase above to use these.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=violations
SUPABASE_TABLE=violation_records

# --- aws_s3 (TODO, see providers/remote_stub.py) ---
